VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# CLI deploy only (gitignored in .env.local — never commit)
# SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
APP_URL=https://app.reachdeskcrm.com
RESEND_API_KEY=your-resend-api-key
VITE_PADDLE_CLIENT_TOKEN=your-paddle-client-side-token
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# Optional: override admin notify recipients for send-upgrade-email (else emails all role=admin)
# ADMIN_NOTIFY_EMAIL=support@reachdeskcrm.com
# Optional: webhook test bypass secret (set on Supabase Edge Functions + send as X-Test-Bypass header)
# TEST_BYPASS_SECRET=your-test-bypass-secret
# Optional: allow sub_test_* cancel/resume bypass in non-production only
# ALLOW_TEST_SUBSCRIPTIONS=true

# Google Calendar Integration
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# VITE_ prefix makes the Client ID available in the browser (needed for OAuth redirect URL only)
# The Client Secret is NEVER exposed to the browser — used only in Supabase Edge Functions
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Separate OAuth client from Calendar. Authorize ONLY drive.file (not spreadsheets) for Google verification.
VITE_GOOGLE_SHEETS_CLIENT_ID=your-google-sheets-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_PICKER_API_KEY=your-google-browser-api-key
# Optional: Cloud project number (improves Picker). Defaults to digits before "-" in the Sheets client ID.
# VITE_GOOGLE_APP_ID=123456789012

# PostHog Analytics & Session Replay (App mode only)
VITE_POSTHOG_KEY=phc_your_posthog_project_api_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
